// Prisma Schema - n8n NeuralGrid
// 모든 필드명이 일관되고 타입 안전성이 보장됨

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// 사용자 및 인증
// ============================================

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  password      String?   // 이메일 로그인용
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  workflows     Workflow[]
  executions    WorkflowExecution[]
  usageRecords  UsageRecord[]
  payments      Payment[]

  @@map("users")
}

// NextAuth
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

// ============================================
// 구독 및 결제
// ============================================

enum SubscriptionPlan {
  FREE
  PRO
  ENTERPRISE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

model Subscription {
  id        String             @id @default(cuid())
  userId    String             @unique
  plan      SubscriptionPlan   @default(FREE)
  status    SubscriptionStatus @default(ACTIVE)

  // 사용 한도
  executionLimit Int @default(1000)
  workflowLimit  Int @default(3)

  // 현재 사용량
  executionCount Int @default(0)
  workflowCount  Int @default(0)

  // 결제 정보
  price              Int?
  billingCycle       String? // monthly, yearly
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("subscriptions")
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  CANCELED
}

model Payment {
  id     String        @id @default(cuid())
  userId String
  amount Int // KRW 단위
  status PaymentStatus @default(PENDING)

  // 플랜 정보
  plan         SubscriptionPlan
  billingCycle String? // monthly, yearly

  // PG사 정보 (Toss Payments)
  pgProvider   String? // toss
  pgOrderId    String? @unique
  pgPaymentKey String?

  // 결제 수단
  paymentMethod String? // 카드, 가상계좌 등
  cardInfo      String? // 카드 정보 (마스킹)

  // 기타
  receiptUrl String?
  paidAt     DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pgOrderId])
  @@map("payments")
}

// ============================================
// 워크플로우
// ============================================

model Workflow {
  id           String  @id @default(cuid())
  name         String
  description  String?
  workflowData Json // n8n 워크플로우 JSON

  // 메타데이터
  tags       String[]
  category   String   @default("general")
  isActive   Boolean  @default(false)
  isPublic   Boolean  @default(false)
  usageCount Int      @default(0)

  // n8n 연동
  n8nWorkflowId String? @unique // n8n의 workflow ID

  // 소유자
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  executions WorkflowExecution[]

  @@index([userId])
  @@index([isPublic])
  @@index([category])
  @@map("workflows")
}

enum ExecutionStatus {
  RUNNING
  SUCCESS
  ERROR
  WAITING
  CANCELED
}

model WorkflowExecution {
  id         String          @id @default(cuid())
  workflowId String
  userId     String
  status     ExecutionStatus @default(RUNNING)

  // 실행 정보
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  duration   Int? // 밀리초

  // 실행 데이터
  executionData Json? // 실행 결과

  // Relations
  workflow Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([workflowId])
  @@index([userId])
  @@index([status])
  @@map("workflow_executions")
}

// ============================================
// 사용량 기록
// ============================================

model UsageRecord {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime // 날짜별 집계
  executionCount Int      @default(0)
  apiCallCount   Int      @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
  @@map("usage_records")
}

// ============================================
// 템플릿
// ============================================

model Template {
  id           String  @id @default(cuid())
  name         String
  description  String
  workflowData Json // 워크플로우 JSON
  category     String
  tags         String[]
  featured     Boolean @default(false)
  usageCount   Int     @default(0)

  // 작성자 (관리자만)
  authorId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([featured])
  @@map("templates")
}
