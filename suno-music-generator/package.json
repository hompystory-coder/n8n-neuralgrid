{
  "name": "suno-music-generator",
  "version": "1.0.0",
  "description": "대량 음악 생성을 위한 Suno API 기반 웹 서비스",
  "main": "server.js",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/index.js",
    "client": "cd client && npm start",
    "build": "cd client && npm run build",
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install"
  },
  "keywords": [
    "suno",
    "music",
    "ai",
    "generator",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fal-ai/serverless-client": "^0.15.0",
    "@google/generative-ai": "^0.24.1",
    "@napi-rs/canvas": "^1.0.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.2",
    "body-parser": "^1.20.2",
    "bull": "^4.12.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "js-yaml": "^4.1.1",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "node-fetch": "^2.7.0",
    "openai": "^6.34.0",
    "redis": "^4.6.11",
    "replicate": "^1.4.0",
    "sharp": "^0.34.5",
    "socket.io": "^4.6.0",
    "uuid": "^9.0.1",
    "ytdl-core": "^4.11.5"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.2",
    "playwright": "^1.59.1"
  }
}
