+        </header>
+
+        <div class="main-card">
+            <!-- Style Selector 컴포넌트가 여기에 렌더링됩니다 -->
+            <div id="styleSelector"></div>
+
+            <!-- 액션 버튼 -->
+            <div class="action-buttons">
+                <button class="btn" onclick="testGetSelectedStyle()">
+                    <span>🎯</span>
+                    선택된 스타일 확인
+                </button>
+                <button class="btn btn-secondary" onclick="testGetPrompt()">
+                    <span>📋</span>
+                    프롬프트 가져오기
+                </button>
+                <button class="btn btn-secondary" onclick="toggleConsole()">
+                    <span>💻</span>
+                    콘솔 토글
+                </button>
+            </div>
+
+            <!-- 콘솔 출력 -->
+            <div class="console-output" id="consoleOutput">
+                <div class="console-line">✅ Style Selector 초기화 완료</div>
+            </div>
+        </div>
+    </div>
+
+    <!-- Style Selector JS -->
+    <script src="/js/styleSelector.js"></script>
+
+    <script>
+        // Style Selector 인스턴스
+        let styleSelector;
+
+        // 페이지 로드 시 초기화
+        window.addEventListener('DOMContentLoaded', () => {
+            console.log('🎵 Style Selector 테스트 페이지 로드');
+            
+            try {
+                styleSelector = new StyleSelector();
+                addConsoleLog('✅ Style Selector 인스턴스 생성 완료');
+            } catch (error) {
+                console.error('❌ Style Selector 초기화 실패:', error);
+                addConsoleLog(`❌ 초기화 실패: ${error.message}`);
+            }
+        });
+
+        // 선택된 스타일 확인
+        function testGetSelectedStyle() {
+            if (!styleSelector) {
+                alert('Style Selector가 초기화되지 않았습니다.');
+                return;
+            }
+
+            const style = styleSelector.getSelectedStyle();
+            
+            console.log('🎯 선택된 스타일:', style);
+            addConsoleLog('🎯 선택된 스타일:');
+            addConsoleLog(JSON.stringify(style, null, 2));
+            
+            if (!style.genre && !style.prompt) {
+                alert('아직 스타일을 선택하지 않았습니다!');
+            } else {
+                alert(`선택된 스타일:\n${JSON.stringify(style, null, 2)}`);
+            }
+        }
+
+        // 프롬프트 가져오기
+        function testGetPrompt() {
+            if (!styleSelector) {
+                alert('Style Selector가 초기화되지 않았습니다.');
+                return;
+            }
+
+            const prompt = styleSelector.getSelectedPrompt();
+            
+            console.log('📋 생성된 프롬프트:', prompt);
+            addConsoleLog(`📋 프롬프트: ${prompt}`);
+            
+            if (!prompt) {
+                alert('먼저 스타일을 선택해주세요!');
+            } else {
+                alert(`Suno 프롬프트:\n\n${prompt}`);
+            }
+        }
+
+        // 콘솔 토글
+        function toggleConsole() {
+            const console = document.getElementById('consoleOutput');
+            console.classList.toggle('active');
+        }
+
+        // 콘솔 로그 추가
+        function addConsoleLog(message) {
+            const console = document.getElementById('consoleOutput');
+            const line = document.createElement('div');
+            line.className = 'console-line';
+            line.textContent = message;
+            console.appendChild(line);
+            console.scrollTop = console.scrollHeight;
+        }
+
+        // 원래 console.log 오버라이드
+        const originalLog = console.log;
+        console.log = function(...args) {
+            originalLog.apply(console, args);
+            addConsoleLog(args.join(' '));
+        };
+
+        const originalError = console.error;
+        console.error = function(...args) {
+            originalError.apply(console, args);
+            addConsoleLog('❌ ' + args.join(' '));
+        };
+    </script>
+</body>
+</html>
